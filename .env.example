# Settings of compose.yaml. Copy to .env (git-ignored) and change the
# change-me values before starting: cp .env.example .env

# Metrics store, both settings together:
#   COMPOSE_PROFILES=victoria   with AIO11Y_BACKEND=victoria
#     VictoriaMetrics cluster (vmstorage, vminsert, vmselect, vmagent)
#   COMPOSE_PROFILES=prometheus with AIO11Y_BACKEND=thanos
#     Prometheus replicas, Thanos sidecar and query, an OpenTelemetry relay
# Logs and traces go to VictoriaLogs and VictoriaTraces in either.
# Give one profile only: the gateways read deploy/${COMPOSE_PROFILES}/.
COMPOSE_PROFILES=victoria
AIO11Y_BACKEND=victoria

# Address collectors reach this host at. ai-o11y renders collector
# configurations that write to http://<this>:GATEWAY_A_PORT (then
# GATEWAY_B_PORT), so it must not be localhost.
AIO11Y_PUBLIC_HOST=192.0.2.10

# Host ports: ai-o11y and the two entry points (node A, node B).
AIO11Y_PORT=8094
GATEWAY_A_PORT=14318
GATEWAY_B_PORT=14319

# Bearer token of the query routes on the gateways (/metrics, /logs,
# /traces). ai-o11y sends it; writes need none.
QUERY_TOKEN=change-me-query

# Bearer token of ai-o11y's API. Empty turns the check off.
AIO11Y_AUTH_TOKEN=change-me-api

# MariaDB holding ai-o11y's targets.
DB_NAME=aio11y
DB_USER=aio11y
DB_PASSWORD=change-me-db

# CB-Tumblebug, where targets come from (optional). The URL includes the
# /tumblebug prefix and must be reachable from the ai-o11y container.
AIO11Y_TUMBLEBUG_BASE_URL=
AIO11Y_TUMBLEBUG_USERNAME=
AIO11Y_TUMBLEBUG_PASSWORD=

# How long every store keeps data, and the disk queue each agent (vmagent,
# vlagent, vtagent) keeps per destination while that one is down. Past the
# queue limit the oldest queued data is dropped.
RETENTION=15d
QUEUE_MAX=1GB

# Image versions.
VM_VERSION=v1.155.0
VL_VERSION=v1.53.0
VT_VERSION=v0.12.1
PROMETHEUS_VERSION=v3.16.0
THANOS_VERSION=v0.42.5
OTELCOL_VERSION=0.164.0
