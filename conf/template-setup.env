# ai-o11y runtime configuration template.
# Copy to conf/setup.env, fill in real values and load it into the environment
# before starting the server (for example `set -a; . conf/setup.env; set +a`).
# conf/setup.env is git-ignored on purpose: never commit real endpoints or
# credentials. Every setting has a default; a part left unset leaves the routes
# that need it answering 503.

# HTTP port the AI-O11y service (cmd/ai-o11y-server) listens on.
export AIO11Y_SERVER_PORT=8094

# Bearer token every route but /aio11y/readyz and the API documentation
# requires. Empty turns the check off (the server logs a warning).
export AIO11Y_AUTH_TOKEN=

# CB-Tumblebug, the management platform targets come from. Used to describe a
# target registered with its nsId/infraId/nodeId only, and by
# POST /aio11y/targets/sync. Empty leaves both unavailable.
# The URL includes the /tumblebug prefix.
export AIO11Y_TUMBLEBUG_BASE_URL=http://localhost:1323/tumblebug
export AIO11Y_TUMBLEBUG_USERNAME=
export AIO11Y_TUMBLEBUG_PASSWORD=
# Credential holder sent as x-credential-holder. Empty sends none.
export AIO11Y_TUMBLEBUG_CREDENTIAL_HOLDER=
export AIO11Y_TUMBLEBUG_TIMEOUT=2m

# MariaDB holding the target table. Tables are created at start. Empty host
# leaves the target routes and queries unavailable.
export AIO11Y_DB_HOST=
export AIO11Y_DB_PORT=3306
export AIO11Y_DB_NAME=aio11y
export AIO11Y_DB_USER=
export AIO11Y_DB_PASSWORD=
# Bounds of one connection attempt and of each read and write on a connection.
export AIO11Y_DB_CONNECT_TIMEOUT=5s
export AIO11Y_DB_READ_TIMEOUT=30s
export AIO11Y_DB_WRITE_TIMEOUT=30s

# Metrics backend: thanos or victoria. The settings below are the same for
# either; a value left at 0 or empty takes the provider's default.
#
# Whichever backend, it must store metric and attribute names as collectors
# send them (system.cpu.time), the names the metric catalog queries:
# Prometheus behind a Thanos Sidecar with otlp.translation_strategy
# NoTranslation, VictoriaMetrics with its default
# (-opentelemetry.usePrometheusNaming off). See poc/deploy for sample setups.
export AIO11Y_BACKEND=thanos

# Prometheus query API addresses (Thanos Querier, vmauth or VictoriaMetrics),
# comma-separated, in order of preference: a query moves to the next when one
# cannot be reached or answers with a 5xx. Empty leaves queries and collector
# configuration unavailable.
export AIO11Y_BACKEND_QUERY_URL=
# Where collectors send samples over OTLP/HTTP (the collector appends
# /v1/metrics), comma-separated, in order of preference: with several, a
# collector moves to the next while one fails, and keeps nothing while all
# fail. Examples: http://prometheus:9090/api/v1/otlp,
# http://vmauth:8427/opentelemetry. Empty leaves collector configuration
# unavailable.
export AIO11Y_BACKEND_WRITE_URL=
# Query timeout, across retries and every query address a query is tried at: a slow
# address leaves the next one only what remains. Empty: thanos 2m (Querier
# default), victoria 30s (-search.maxQueryDuration default). A value given must
# be positive.
export AIO11Y_BACKEND_TIMEOUT=
# Time to connect to one query address before moving to the next. Empty: 5s.
# A value given must be positive.
export AIO11Y_BACKEND_CONNECT_TIMEOUT=
# Query chunks run at once (empty: thanos 10, victoria 4) and target ids per
# chunk (empty: 255). A value given must be a positive integer.
export AIO11Y_BACKEND_MAX_CONCURRENT=
export AIO11Y_BACKEND_MAX_IDS=
# Basic auth account queries are sent with, such as a vmauth user allowed to
# query. Both empty sends none.
export AIO11Y_BACKEND_QUERY_USERNAME=
export AIO11Y_BACKEND_QUERY_PASSWORD=
# Basic auth account collectors write with, such as a vmauth user allowed to
# write. Only the username is set here: the rendered collector configuration
# reads the password from AIO11Y_WRITE_PASSWORD in the environment of the
# collector's host, so set that variable wherever a collector runs. Empty
# writes with no account.
export AIO11Y_BACKEND_WRITE_USERNAME=
# Off: a query fails when any store behind the query address fails, rather
# than answering from the stores that respond. Single-node VictoriaMetrics has
# one store and ignores it.
export AIO11Y_BACKEND_PARTIAL_RESPONSE=false

# Port on localhost the rendered collector configurations serve the
# collector's own metrics on (Prometheus format). 0 turns them off, so a
# collector opens no port that another collector on the host may hold.
export AIO11Y_COLLECTOR_TELEMETRY_PORT=0
# Directory on each collector's host where the rendered configuration keeps
# the samples it cannot send yet (a disk queue, up to 256 MiB), so they are
# sent once the backend answers again, across a collector restart too. The
# collector creates it. The default is under the installed service's state
# directory.
export AIO11Y_COLLECTOR_STORAGE_DIR=/var/lib/aio11y-otelcol/queue
